          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "SymbolPicker",
          "product-name": "SymbolPicker",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "ZIPFoundation",
          "product-name": "ZIPFoundation",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "passkeepr",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "PassKeepr/PassKeepr.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "$(CI_BUILD_NUMBER)",
        "DEVELOPMENT_ASSET_PATHS": "\"PassKeepr/Preview Content\"",
        "ENABLE_PREVIEWS": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_FILE": "PassKeepr/Info.plist",
        "INFOPLIST_KEY_CFBundleDisplayName": "PassKeepr",
        "INFOPLIST_KEY_LSApplicationCategoryType": "public.app-category.utilities",
        "INFOPLIST_KEY_NSCameraUsageDescription": "Camera access is required to scan codes",
        "INFOPLIST_KEY_UIApplicationSceneManifest_Generation": "YES",
        "INFOPLIST_KEY_UIApplicationSupportsIndirectInputEvents": "YES",
        "INFOPLIST_KEY_UILaunchScreen_Generation": "YES",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait",
        "INFOPLIST_KEY_UISupportedInterfaceOrientations_iPad": "UIInterfaceOrientationLandscapeLeft UIInterfaceOrientationLandscapeRight UIInterfaceOrientationPortrait UIInterfaceOrientationPortraitUpsideDown",
        "INFOPLIST_KEY_UISupportsDocumentBrowser": "YES",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/Frameworks",
        ],
        "LOCAL_SERVER": "false",
        "MARKETING_VERSION": "1.08",
        "PRODUCT_BUNDLE_IDENTIFIER": "AHanshaw.PassKeepr",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "SUPPORTED_PLATFORMS": "iphoneos iphonesimulator",
        "SUPPORTS_MACCATALYST": "NO",
        "SUPPORTS_MAC_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SUPPORTS_XR_DESIGNED_FOR_IPHONE_IPAD": "NO",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_VERSION": "5.0",
        "TARGETED_DEVICE_FAMILY": "1,2",
      },
    }, {
      "name": "PassKeeprUITests",
      "id": "3A02E74F2AF6EE1B00383BC2",
      "product": "Products/PassKeeprUITests.xctest",
      "product-type": "bundle.ui-testing",
      "test-host-target": "PassKeepr",
      "dependencies": [
        "PassKeepr",
