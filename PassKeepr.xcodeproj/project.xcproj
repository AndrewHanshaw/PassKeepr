  "targets": [
    {
      "name": "PassKeepr",
      "id": "3A02E7352AF6EE1000383BC2",
      "product": "Products/PassKeepr.app",
      "product-type": "application",
      "dependencies": [
        "PkPassShare",
      ],
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
        {
          "kind": "copy",
          "name": "Embed Foundation Extensions",
          "bundle-base-path": "plugins-directory",
        },
      ],
      "package-product-members": [
        {
          "product-name": "PassKeeprCore",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "LocationPickerForSwiftUI",
          "product-name": "LocationPicker",
          "build-phase": { "build-phase": "frameworks" },
